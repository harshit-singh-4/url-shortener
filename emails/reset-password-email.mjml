
<mjml>
  <mj-head>
    <mj-title>Reset Your Password</mj-title>

    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto:300,400,500"
    />

    <mj-attributes>
      <mj-all font-family="Roboto, Arial, sans-serif" />
    </mj-attributes>

    <mj-style>
      .reset-link {
        color: #2563eb;
        text-decoration: none;
        word-break: break-all;
      }

      .footer-text {
        color: #98a2b3;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f5f7fa">

    <mj-section
      background-color="#ffffff"
      border-radius="8px"
      padding="40px 30px"
    >
      <mj-column>

        <mj-text
          font-size="24px"
          font-weight="500"
          color="#1f2937"
          align="center"
          padding-bottom="20px"
        >
          Reset Your Password
        </mj-text>

        <mj-text
          font-size="16px"
          color="#4b5563"
          line-height="24px"
        >
          Hi <%= name %>,
        </mj-text>

        <mj-text
          font-size="16px"
          color="#4b5563"
          line-height="24px"
        >
          We received a request to reset the password for your
          URL Shortener account.
        </mj-text>

        <mj-text
          font-size="16px"
          color="#4b5563"
          line-height="24px"
        >
          Click the button below to create a new password:
        </mj-text>

        <mj-button
          background-color="#2563eb"
          color="#ffffff"
          border-radius="6px"
          font-size="16px"
          font-weight="500"
          inner-padding="14px 25px"
          href="<%= link %>"
          target="_blank"
        >
          Reset Password
        </mj-button>

        <mj-text
          font-size="16px"
          color="#4b5563"
          line-height="24px"
          padding-top="20px"
        >
          This password reset link will expire in 1 hour.
        </mj-text>

        <mj-text
          font-size="16px"
          color="#4b5563"
          line-height="24px"
        >
          If you did not request a password reset, you can safely
          ignore this email. Your current password will remain unchanged.
        </mj-text>

        <mj-divider
          border-width="1px"
          border-color="#e5e7eb"
          padding="25px 0"
        />

        <mj-text
          font-size="14px"
          color="#6b7280"
          line-height="20px"
        >
          If the button doesn't work, copy and paste this link into
          your browser:
        </mj-text>

        <mj-text
          font-size="14px"
          line-height="20px"
          padding-top="8px"
        >
          <a
            href="<%= link %>"
            class="reset-link"
          >
            <%= link %>
          </a>
        </mj-text>

      </mj-column>
    </mj-section>

    <mj-section padding="24px 0">
      <mj-column>

        <mj-text
          css-class="footer-text"
          font-size="14px"
          align="center"
          line-height="20px"
        >
          © 2026 URL SHORTENER. All rights reserved.
        </mj-text>

        <mj-text
          css-class="footer-text"
          font-size="14px"
          align="center"
          line-height="20px"
          padding-top="8px"
        >
          Secure password recovery
        </mj-text>

      </mj-column>
    </mj-section>

  </mj-body>
</mjml>

