<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>Edit Profile</title>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        font-family: Arial, sans-serif;
        background: #f5f5f5;
    }

    .container {
        width: 100%;
        max-width: 450px;
        background: white;
        padding: 35px;
        border-radius: 12px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
    }

    .header {
        margin-bottom: 30px;
    }

    .header h1 {
        font-size: 26px;
        color: #111;
        margin-bottom: 8px;
    }

    .header p {
        color: #777;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #333;
    }

    .form-group input {
        width: 100%;
        padding: 13px 14px;
        border: 1px solid #ccc;
        border-radius: 7px;
        font-size: 15px;
        outline: none;
    }

    .form-group input:focus {
        border-color: #111;
    }

    .email-info {
        background: #f5f5f5;
        padding: 12px 14px;
        border-radius: 7px;
        color: #666;
        font-size: 14px;
    }

    .buttons {
        display: flex;
        gap: 10px;
        margin-top: 25px;
    }

    .btn {
        flex: 1;
        padding: 13px;
        border-radius: 7px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        text-decoration: none;
    }

    .save-btn {
        border: none;
        background: #111;
        color: white;
    }

    .save-btn:hover {
        background: #333;
    }

    .cancel-btn {
        border: 1px solid #ccc;
        background: white;
        color: #333;
    }

    .cancel-btn:hover {
        background: #f5f5f5;
    }

    @media (max-width: 480px) {
        .container {
            padding: 25px 20px;
        }

        .buttons {
            flex-direction: column;
        }
    }
</style>


</head>

<body>


<div class="container">

    <div class="header">
        <h1>Edit Profile</h1>
        <p>Update your profile information</p>
    </div>

    <form action="/profile/edit" method="POST">

        <div class="form-group">
            <label for="name">Name</label>

            <input
                type="text"
                id="name"
                name="name"
                value="<%= user.name %>"
                placeholder="Enter your name"
                required
                minlength="2"
                maxlength="50"
            >
        </div>

        <div class="form-group">
            <label>Email</label>

            <div class="email-info">
                <%= user.email %>
            </div>
        </div>

        <div class="buttons">

            <a href="/profile" class="btn cancel-btn">
                Cancel
            </a>

            <button type="submit" class="btn save-btn">
                Save Changes
            </button>

        </div>

    </form>

</div>


</body>
</html>
